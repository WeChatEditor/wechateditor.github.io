{
  "name": "jlab-wechat-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.26.0"
  },
  "scripts": {
    "prepare": "node scripts/git/install-hooks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "docs:check": "node scripts/docs/check.mjs",
    "modules:check": "node scripts/architecture/check-modules.mjs",
    "docs:archive:check": "node scripts/docs/archive-audit.mjs",
    "docs:archive:check:ci": "node scripts/docs/archive-audit.mjs --ci",
    "docs:archive:check:bootstrap": "node scripts/docs/archive-audit.mjs --bootstrap",
    "docs:archive:init": "node scripts/docs/archive-audit.mjs --init",
    "docs:archive:complete": "node scripts/docs/archive-audit.mjs --complete",
    "commits:check": "node scripts/git/check-range.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "node --test scripts/**/*.test.mjs && pnpm -r --if-present test",
    "dev:frontend": "pnpm --filter @jlab-wechat-editor/frontend dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vue-eslint-parser": "^10.4.1",
    "yaml": "^2.9.1",
    "prettier": "^3.9.9"
  }
}
